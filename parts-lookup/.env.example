PORT=3000

# Optional. If unset, the app runs in demo recognition mode (deterministic
# mock identification, no external calls). Set this to enable real photo
# identification via the Claude API.
ANTHROPIC_API_KEY=

# Any current Claude model with vision support works. Defaults to the
# cheapest current vision-capable model — good enough for part ID and
# keeps per-photo cost near-zero while testing.
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
